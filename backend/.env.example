STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./storage
DATABASE_URL=sqlite:///./storage/vigil_recorder.sqlite3
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production raw collection mode:
